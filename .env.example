# Copy this file to .env and paste your own Resend key there.
# .env is gitignored — never commit the real key.
RESEND_API_KEY=replace_with_your_resend_key

# Optional. Resend only allows a sender you have verified, or its test sender.
# Default: CyburrHunee <onboarding@resend.dev>
# RESEND_FROM=CyburrHunee <hello@cyburrhunee.com>
